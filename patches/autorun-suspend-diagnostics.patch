+    horizon_diag_scope_push(&inner, 0x66, 0x2000, 0x4000);
+    horizon_diag_scope_phase(HORIZON_DIAG_HANDLER);
+    horizon_diag_emit(HORIZON_DIAG_PARK_ENTER, 4, 132, 0x88, 2, 3, 0x123, 0x12345678, 7, 9);
+    horizon_diag_scope_pop(&inner);
+    horizon_diag_emit(HORIZON_DIAG_PARK_ENTER, 4, 132, 0x88, 2, 3, 0x123, 0x12345678, 7, 9);
+    horizon_diag_scope_pop(&outer);
+    assert(horizon_diag_current.syscall == ~0u && !horizon_diag_current.phase);
+    horizon_suspend_diag_dump(output);
+    assert(records == 3 && callbacks == 4 && horizon_suspend_ring.sequence == 7);
+}
+int main(void)
+{
+    nested_scopes();
+    callbacks = records = 0;
+    memset(&horizon_suspend_ring, 0, sizeof(horizon_suspend_ring));
+    horizon_suspend_diag_dump(output);
+    assert(callbacks == 1 && !records);
+    puts("suspend diagnostics: numeric dump, nested syscall restoration and callback lock boundaries passed");
+}
+'''
+    (build / 'recorder.c').write_text(fixture)
+    subprocess.run([cc, *options, str(build / 'recorder.c'), '-o', str(build / 'recorder')], check=True)
+    subprocess.run([str(build / 'recorder')], check=True, timeout=30)
