+#!/usr/bin/env python3
+"""Run real NtAlert/WaitForAlert paths and inspect emitted numeric records."""
+from pathlib import Path
+import os
+import subprocess
+import tempfile
+root = Path(__file__).resolve().parents[2]
+source = (root / 'dlls/ntdll/unix/sync.c').read_text()
+def block(signature):
+    start = source.index(signature)
+    end, depth = source.index('{', start) + 1, 1
+    while depth:
+        depth += (source[end] == '{') - (source[end] == '}')
+        end += 1
+    return source[start:end]
+fixture = r'''
+#include <assert.h>
+#include <errno.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <time.h>
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winternl.h"
+#include "horizon_suspend_diag.h"
+#define USE_FUTEX
+#define __SWITCH__
+#define TRACE(...) ((void)0)
+#define TICKSPERSEC 10000000
+#define TIMEOUT_INFINITE 0x7fffffffffffffffLL
+static __thread TEB teb;
+#undef NtCurrentTeb
+#define NtCurrentTeb() (&teb)
+struct thread_data { unsigned tid; };
+static __thread struct thread_data thread_data;
+static struct thread_data *get_thread_data(void) { return &thread_data; }
+union tid_alert_entry { LONG futex; };
+static union tid_alert_entry entries[8];
+static union tid_alert_entry *get_tid_alert_entry(HANDLE tid) { unsigned n = HandleToULong(tid); return n < 8 ? &entries[n] : NULL; }
+static struct horizon_diag_ring diagnostics;
+void horizon_diag_record(const struct horizon_diag_event *event) { horizon_diag_ring_write(&diagnostics, event); }
+/* The OS address-wait stand-in provides actual pthread synchronization; the
+ * NtAlert/Wait functions and diagnostic records under test are production code. */
+static pthread_mutex_t mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t changed = PTHREAD_COND_INITIALIZER;
+static unsigned waiting;
+static int futex_wait(const LONG *addr, int value, struct timespec *timeout)
+{
+    int result = 0;
+    pthread_mutex_lock(&mutex);
+    waiting++;
+    pthread_cond_broadcast(&changed);
+    if (__atomic_load_n(addr, __ATOMIC_ACQUIRE) == value) {
+        if (timeout) { struct timespec now; clock_gettime(CLOCK_REALTIME, &now); result = pthread_cond_timedwait(&changed, &mutex, &now); }
+        else while (__atomic_load_n(addr, __ATOMIC_ACQUIRE) == value) pthread_cond_wait(&changed, &mutex);
+    }
+    pthread_mutex_unlock(&mutex);
+    if (result) { errno = result; return -1; }
+    return 0;
+}
+static int futex_wake_one(const LONG *addr)
+{
+    (void)addr; pthread_mutex_lock(&mutex); pthread_cond_broadcast(&changed); pthread_mutex_unlock(&mutex); return 0;
+}
+static LONGLONG get_absolute_timeout(const LARGE_INTEGER *timeout) { return timeout->QuadPart; }
+static LONGLONG update_timeout(ULONGLONG end) { (void)end; return 0; }
+'''
+fixture += block('NTSTATUS WINAPI NtAlertThreadByThreadId(') + '\n' + block('NTSTATUS WINAPI NtWaitForAlertByThreadId(')
+fixture += r'''
+static void *waiter(void *unused)
+{
+    (void)unused;
+    thread_data.tid = 4; teb.ClientId.UniqueThread = (HANDLE)4;
+    assert(NtWaitForAlertByThreadId((void *)0x112233, NULL) == STATUS_ALERTED);
+    return NULL;
+}
+int main(void)
+{
+    pthread_t thread;
+    struct horizon_diag_event events[16];
+    unsigned count, began = 0, ended = 0, woke = 0;
+    teb.ClientId.UniqueThread = (HANDLE)7;
+    assert(!pthread_create(&thread, NULL, waiter, NULL));
+    pthread_mutex_lock(&mutex);
+    while (!waiting) pthread_cond_wait(&changed, &mutex);
+    pthread_mutex_unlock(&mutex);
+    assert(!NtAlertThreadByThreadId((HANDLE)4));
+    assert(!pthread_join(thread, NULL));
+    count = horizon_diag_ring_snapshot(&diagnostics, events, 16);
+    assert(count == 3);
+    for (unsigned i = 0; i < count; i++) {
+        struct horizon_diag_event *e = &events[i];
+        assert(e->target == 4 && e->address == (uintptr_t)&entries[4].futex);
+        if (e->kind == HORIZON_DIAG_WAIT_ALERT) { assert(e->caller == 4 && e->handle == 0x112233 && !e->value); began++; }
+        else if (e->kind == HORIZON_DIAG_WAIT_ALERT_RESULT) { assert(e->caller == 4 && e->status == STATUS_ALERTED); ended++; }
+        else if (e->kind == HORIZON_DIAG_ALERT) { assert(e->caller == 7 && !e->value && !e->status); woke++; }
+        else assert(0);
+    }
+    assert(began == 1 && ended == 1 && woke == 1);
+    thread_data.tid = 4; teb.ClientId.UniqueThread = (HANDLE)4;
+    { LARGE_INTEGER timeout = { .QuadPart = 0 }; assert(NtWaitForAlertByThreadId((void *)0x556677, &timeout) == STATUS_TIMEOUT); }
+    count = horizon_diag_ring_snapshot(&diagnostics, events, 16);
+    assert(count == 5 && events[4].kind == HORIZON_DIAG_WAIT_ALERT_RESULT && events[4].status == STATUS_TIMEOUT);
+    assert(events[3].handle == 0x556677 && events[3].flags == 1);
+    assert(NtAlertThreadByThreadId((HANDLE)99) == STATUS_INVALID_CID);
+    puts("suspend diagnostics: real alert wait/wake, caller/recipient/address and timeout records passed");
+}
+'''
+with tempfile.TemporaryDirectory(prefix='suspend-alerts-') as directory:
+    path = Path(directory)
+    (path / 'test.c').write_text(fixture)
+    subprocess.run([os.environ.get('WINE_NX_HOST_CC', '/usr/bin/clang'), '-std=gnu11', '-g', '-O1',
+                    '-fms-extensions', '-Wall', '-Wextra', '-Werror', '-Wno-missing-field-initializers',
+                    '-fsanitize=address,undefined', '-fno-sanitize-recover=all', '-pthread', '-D__WINESRC__', '-D_WIN64',
+                    '-I' + str(root / 'include'), '-I' + str(root / 'dlls/ntdll/unix'),
+                    str(path / 'test.c'), '-o', str(path / 'test')], check=True)
+    subprocess.run([str(path / 'test')], check=True, timeout=30)
