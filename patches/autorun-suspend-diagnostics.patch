+/* Bounded numeric suspension diagnostics; LGPL-2.1-or-later. */
+#ifndef HORIZON_SUSPEND_DIAG_H
+#define HORIZON_SUSPEND_DIAG_H
+#include <stdint.h>
+#ifndef HORIZON_DIAG_CAPACITY
+#define HORIZON_DIAG_CAPACITY 2048
+#endif
+struct horizon_diag_event
+{
+    uint64_t sequence, timestamp, handle, address, pc, sp;
+    uint32_t kind, caller, target, old_count, new_count, status, syscall, phase, value, flags;
+};
+/* Durable per-target history. Owner updates are serialized by the server's
+ * existing object mutex; park updates have one writer, the target thread.
+ * Readers never acquire a writer lock or prevent publication. */
+struct horizon_diag_saved { uint64_t version, generation; struct horizon_diag_event event; };
+#define HORIZON_DIAG_FIELDS(X) \
+    X(sequence) X(timestamp) X(handle) X(address) X(pc) X(sp) \
+    X(kind) X(caller) X(target) X(old_count) X(new_count) X(status) X(syscall) X(phase) X(value) X(flags)
+static inline void horizon_diag_saved_write(struct horizon_diag_saved *saved, const struct horizon_diag_event *event)
+{
+    uint64_t version = __atomic_fetch_add(&saved->version, 1, __ATOMIC_ACQ_REL);
+#define STORE_FIELD(name) __atomic_store_n(&saved->event.name, event->name, __ATOMIC_RELAXED);
+    HORIZON_DIAG_FIELDS(STORE_FIELD)
+#undef STORE_FIELD
+    __atomic_store_n(&saved->event.sequence, version / 2 + 1, __ATOMIC_RELAXED);
+    __atomic_fetch_add(&saved->version, 1, __ATOMIC_RELEASE);
+}
+static inline int horizon_diag_saved_read(const struct horizon_diag_saved *saved, struct horizon_diag_event *out)
+{
+    uint64_t before = __atomic_load_n(&saved->version, __ATOMIC_ACQUIRE);
+    if (!before || (before & 1)) return 0;
+#define LOAD_FIELD(name) out->name = __atomic_load_n(&saved->event.name, __ATOMIC_RELAXED);
+    HORIZON_DIAG_FIELDS(LOAD_FIELD)
+#undef LOAD_FIELD
+    __atomic_thread_fence(__ATOMIC_ACQUIRE);
+    return __atomic_load_n(&saved->version, __ATOMIC_RELAXED) == before && out->kind;
+}
+static inline void horizon_diag_saved_clear(struct horizon_diag_saved *saved)
+{
+    const struct horizon_diag_event empty = {0};
+    horizon_diag_saved_write(saved, &empty);
+}
+#undef HORIZON_DIAG_FIELDS
+enum horizon_diag_kind
+{
+    HORIZON_DIAG_SUSPEND_ENTER = 1, HORIZON_DIAG_BACKEND_ENTER, HORIZON_DIAG_BACKEND_EXIT,
+    HORIZON_DIAG_SUSPEND_EXIT, HORIZON_DIAG_SERVER_SUSPEND, HORIZON_DIAG_SERVER_RESUME,
+    HORIZON_DIAG_GET_CONTEXT, HORIZON_DIAG_GET_CONTEXT_RESULT,
+    HORIZON_DIAG_SET_CONTEXT, HORIZON_DIAG_SET_CONTEXT_RESULT,
+    HORIZON_DIAG_PARK_ENTER, HORIZON_DIAG_PARK_EXIT,
+    HORIZON_DIAG_WAIT_ALERT, HORIZON_DIAG_WAIT_ALERT_RESULT, HORIZON_DIAG_ALERT,
+    HORIZON_DIAG_SERVER_PARK, HORIZON_DIAG_SERVER_UNPARK
+};
+enum horizon_diag_phase { HORIZON_DIAG_ENTRY = 1, HORIZON_DIAG_HANDLER, HORIZON_DIAG_RETURN };
+struct horizon_diag_scope
+{
+    uint64_t pc, sp;
+    uint32_t syscall, phase;
+};
+/* Weak so standalone ntdll extraction/smoke programs need no recorder. */
+#ifdef __APPLE__
+#define HORIZON_DIAG_WEAK __attribute__((weak_import))
+#else
+#define HORIZON_DIAG_WEAK __attribute__((weak))
+#endif
+extern void horizon_diag_record(const struct horizon_diag_event *) HORIZON_DIAG_WEAK;
+extern void horizon_diag_save(struct horizon_diag_saved *, const struct horizon_diag_event *) HORIZON_DIAG_WEAK;
+extern void horizon_diag_scope_push(struct horizon_diag_scope *, uint32_t, uint64_t, uint64_t) HORIZON_DIAG_WEAK;
+extern void horizon_diag_scope_pop(struct horizon_diag_scope *) HORIZON_DIAG_WEAK;
+extern void horizon_diag_scope_phase(uint32_t) HORIZON_DIAG_WEAK;
+extern void horizon_diag_scope_reset(void) HORIZON_DIAG_WEAK;
+static inline void horizon_diag_emit_saved(struct horizon_diag_saved *saved, uint32_t kind, uint32_t caller, uint32_t target,
+                                     uint64_t handle, uint32_t old_count, uint32_t new_count,
+                                     uint32_t status, uint64_t address, uint32_t value, uint32_t flags)
+{
+    struct horizon_diag_event event = {0};
+    if (!horizon_diag_record && !horizon_diag_save) return;
+    event.kind = kind; event.caller = caller; event.target = target; event.handle = handle;
+    event.old_count = old_count; event.new_count = new_count; event.status = status;
+    event.address = address; event.value = value; event.flags = flags;
+    if (horizon_diag_record) horizon_diag_record(&event);
+    if (saved && horizon_diag_save) horizon_diag_save(saved, &event);
+}
+static inline void horizon_diag_emit(uint32_t kind, uint32_t caller, uint32_t target,
+                                     uint64_t handle, uint32_t old_count, uint32_t new_count,
+                                     uint32_t status, uint64_t address, uint32_t value, uint32_t flags)
+{
+    horizon_diag_emit_saved(0, kind, caller, target, handle, old_count, new_count, status, address, value, flags);
+}
+struct horizon_diag_slot { unsigned guard; struct horizon_diag_event event; };
+struct horizon_diag_ring { uint64_t sequence, dropped; struct horizon_diag_slot slots[HORIZON_DIAG_CAPACITY]; };
+/* Each guard is a try-lock: diagnostics must never wait for a paused writer.
+ * All event bytes are copied under this guard, including by readers. */
+static inline void horizon_diag_ring_write(struct horizon_diag_ring *ring, const struct horizon_diag_event *event)
+{
+    uint64_t sequence = __atomic_add_fetch(&ring->sequence, 1, __ATOMIC_RELAXED);
+    struct horizon_diag_slot *slot = &ring->slots[(sequence - 1) % HORIZON_DIAG_CAPACITY];
+    if (__atomic_exchange_n(&slot->guard, 1, __ATOMIC_ACQUIRE))
+    {
+        __atomic_add_fetch(&ring->dropped, 1, __ATOMIC_RELAXED);
+        return;
+    }
+    /* A writer may have been descheduled before claiming its slot. Never let
+     * that old reservation replace a newer event after wraparound. */
+    if (slot->event.sequence < sequence)
+    {
+        slot->event = *event;
+        slot->event.sequence = sequence;
+    }
+    else __atomic_add_fetch(&ring->dropped, 1, __ATOMIC_RELAXED);
+    __atomic_store_n(&slot->guard, 0, __ATOMIC_RELEASE);
+}
+static inline int horizon_diag_ring_read(struct horizon_diag_ring *ring, uint64_t sequence,
+                                          struct horizon_diag_event *out)
+{
+    struct horizon_diag_slot *slot = &ring->slots[(sequence - 1) % HORIZON_DIAG_CAPACITY];
+    int found;
+    if (__atomic_exchange_n(&slot->guard, 1, __ATOMIC_ACQUIRE)) return 0;
+    found = slot->event.sequence == sequence;
+    if (found) *out = slot->event;
+    __atomic_store_n(&slot->guard, 0, __ATOMIC_RELEASE);
+    return found;
+}
+static inline unsigned horizon_diag_ring_snapshot(struct horizon_diag_ring *ring, struct horizon_diag_event *out, unsigned capacity)
+{
+    uint64_t end = __atomic_load_n(&ring->sequence, __ATOMIC_RELAXED), start;
+    unsigned count = 0;
+    if (!out || !capacity) return 0;
+    if (capacity > HORIZON_DIAG_CAPACITY) capacity = HORIZON_DIAG_CAPACITY;
+    start = end > capacity ? end - capacity + 1 : 1;
+    for (uint64_t sequence = start; sequence <= end; sequence++)
+        if (horizon_diag_ring_read(ring, sequence, &out[count])) count++;
+    return count;
+}
+#endif
