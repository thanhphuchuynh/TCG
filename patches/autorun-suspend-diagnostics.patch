+/* Numeric publication, overflow and bounded-progress regression for the real ring. */
+#include <assert.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#define HORIZON_DIAG_CAPACITY 32
+#include "horizon_suspend_diag.h"
+static struct horizon_diag_ring ring;
+static unsigned done;
+static struct horizon_diag_event event(unsigned value)
+{
+    struct horizon_diag_event e = {0};
+    e.timestamp = (uint64_t)value * 17;
+    e.caller = value; e.target = value ^ 0x55aa;
+    e.handle = (uint64_t)value * 3; e.address = ~e.handle;
+    e.status = value ^ 0x1234; e.old_count = value + 7; e.new_count = value + 8;
+    e.kind = 9; e.syscall = value + 11; e.phase = 3; e.value = value + 13;
+    return e;
+}
+static void valid(const struct horizon_diag_event *e)
+{
+    unsigned v = e->caller;
+    assert(e->sequence && e->timestamp == (uint64_t)v * 17);
+    assert(e->target == (v ^ 0x55aa) && e->handle == (uint64_t)v * 3);
+    assert(e->address == ~e->handle && e->status == (v ^ 0x1234));
+    assert(e->old_count == v + 7 && e->new_count == v + 8);
+    assert(e->kind == 9 && e->syscall == v + 11 && e->phase == 3 && e->value == v + 13);
+}
+static void wrap_and_bounds(void)
+{
+    struct { uint64_t before; struct horizon_diag_event out[7]; uint64_t after; } guarded;
+    struct horizon_diag_event all[HORIZON_DIAG_CAPACITY];
+    unsigned n;
+    for (unsigned i = 1; i <= 96; i++) { struct horizon_diag_event e = event(i); horizon_diag_ring_write(&ring, &e); }
+    n = horizon_diag_ring_snapshot(&ring, all, HORIZON_DIAG_CAPACITY);
+    assert(n == HORIZON_DIAG_CAPACITY);
+    for (unsigned i = 0; i < n; i++) { valid(&all[i]); assert(all[i].sequence == i + 65 && all[i].caller == i + 65); }
+    guarded.before = 0x87654321; guarded.after = 0x12345678;
+    n = horizon_diag_ring_snapshot(&ring, guarded.out, 7);
+    assert(n == 7 && guarded.before == 0x87654321 && guarded.after == 0x12345678);
+    for (unsigned i = 0; i < n; i++) assert(guarded.out[i].sequence == i + 90);
+    assert(!horizon_diag_ring_snapshot(&ring, NULL, 0));
+    assert(!horizon_diag_ring_snapshot(&ring, NULL, 10));
+}
+static void busy_slot_never_waits(void)
+{
+    struct horizon_diag_event e = event(99), out[HORIZON_DIAG_CAPACITY];
+    uint64_t next = ring.sequence + 1, dropped = ring.dropped;
+    unsigned index = (unsigned)((next - 1) % HORIZON_DIAG_CAPACITY);
+    __atomic_store_n(&ring.slots[index].guard, 1, __ATOMIC_RELEASE);
+    horizon_diag_ring_write(&ring, &e);
+    assert(ring.sequence == next && ring.dropped == dropped + 1);
+    assert(horizon_diag_ring_snapshot(&ring, out, HORIZON_DIAG_CAPACITY) <= HORIZON_DIAG_CAPACITY - 1);
+    __atomic_store_n(&ring.slots[index].guard, 0, __ATOMIC_RELEASE);
+}
+static void *writer(void *arg)
+{
+    unsigned base = (unsigned)(uintptr_t)arg;
+    for (unsigned i = 0; i < 25000; i++) { struct horizon_diag_event e = event(base + i); horizon_diag_ring_write(&ring, &e); }
+    __atomic_add_fetch(&done, 1, __ATOMIC_RELEASE);
+    return NULL;
+}
+static void concurrent_publication(void)
+{
+    pthread_t threads[4];
+    struct horizon_diag_event out[13];
+    uint64_t before = ring.sequence;
+    unsigned snapshots = 0;
+    for (unsigned i = 0; i < 4; i++) assert(!pthread_create(&threads[i], NULL, writer, (void *)(uintptr_t)(100000 * (i + 1))));
+    do {
+        unsigned n = horizon_diag_ring_snapshot(&ring, out, 13);
+        assert(n <= 13);
+        for (unsigned i = 0; i < n; i++) { valid(&out[i]); if(i) assert(out[i].sequence > out[i-1].sequence); }
+        snapshots++;
+    } while (__atomic_load_n(&done, __ATOMIC_ACQUIRE) != 4);
+    for (unsigned i = 0; i < 4; i++) assert(!pthread_join(threads[i], NULL));
+    assert(ring.sequence == before + 100000 && snapshots);
+}
+static struct horizon_diag_saved saved;
+static void *durable_writer(void *unused)
+{
+    (void)unused;
+    for (unsigned i = 1; i <= 100000; i++) {
+        struct horizon_diag_event e = event(i);
+        horizon_diag_saved_write(&saved, &e);
+    }
+    __atomic_add_fetch(&done, 1, __ATOMIC_RELEASE);
+    return NULL;
+}
+static void *generation_controller(void *unused)
+{
+    (void)unused;
+    for (unsigned i = 0; i < 100000; i++) __atomic_add_fetch(&saved.generation, 1, __ATOMIC_RELEASE);
+    __atomic_add_fetch(&done, 1, __ATOMIC_RELEASE);
+    return NULL;
+}
+static void durable_publication(void)
+{
+    pthread_t thread, controller;
+    struct horizon_diag_event out;
+    assert(!horizon_diag_saved_read(&saved, &out));
+    done = 0;
+    assert(!pthread_create(&thread, NULL, durable_writer, NULL));
+    assert(!pthread_create(&controller, NULL, generation_controller, NULL));
+    do { if (horizon_diag_saved_read(&saved, &out)) valid(&out); }
+    while (__atomic_load_n(&done, __ATOMIC_ACQUIRE) != 2);
+    assert(!pthread_join(thread, NULL));
+    assert(!pthread_join(controller, NULL));
+    assert(saved.generation == 100000);
+    assert(horizon_diag_saved_read(&saved, &out)); valid(&out);
+    assert(out.caller == 100000 && out.sequence == 100000);
+    horizon_diag_saved_clear(&saved);
+    assert(!horizon_diag_saved_read(&saved, &out));
+    /* A writer in publication never blocks the snapshot reader. */
+    __atomic_store_n(&saved.version, 3, __ATOMIC_RELEASE);
+    assert(!horizon_diag_saved_read(&saved, &out));
+}
+int main(void)
+{
+    wrap_and_bounds(); busy_slot_never_waits(); concurrent_publication(); durable_publication();
+    printf("suspend diagnostics: wraparound, bounded snapshot, busy-slot drop 100000 concurrent ring publications and durable atomic snapshots passed\n");
+}
