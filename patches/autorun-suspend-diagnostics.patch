+/* Numeric diagnostics only: producers use bounded try-lock slots and never
+ * allocate, format output or acquire a Wine/server/CPU lock. */
+static struct horizon_diag_ring horizon_suspend_ring;
+static __thread struct horizon_diag_scope horizon_diag_current = { .syscall = ~0u };
+
+void horizon_diag_scope_push(struct horizon_diag_scope *scope, uint32_t syscall, uint64_t pc, uint64_t sp)
+{
+    *scope = horizon_diag_current;
+    horizon_diag_current = (struct horizon_diag_scope){ .syscall = syscall, .phase = HORIZON_DIAG_ENTRY, .pc = pc, .sp = sp };
+}
+
+void horizon_diag_scope_pop(struct horizon_diag_scope *scope)
+{
+    horizon_diag_current = *scope;
+}
+
+void horizon_diag_scope_phase(uint32_t phase)
+{
+    horizon_diag_current.phase = phase;
+}
+
+void horizon_diag_scope_reset(void)
+{
+    horizon_diag_current = (struct horizon_diag_scope){ .syscall = ~0u };
+}
+
+void horizon_diag_record(const struct horizon_diag_event *input)
+{
+    struct horizon_diag_event event = *input;
+    event.timestamp = armGetSystemTick();
+    event.syscall = horizon_diag_current.syscall;
+    event.phase = horizon_diag_current.phase;
+    event.pc = horizon_diag_current.pc;
+    event.sp = horizon_diag_current.sp;
+    horizon_diag_ring_write(&horizon_suspend_ring, &event);
+}
+
+void horizon_diag_save(struct horizon_diag_saved *saved, const struct horizon_diag_event *input)
+{
+    struct horizon_diag_event event = *input;
+    event.timestamp = armGetSystemTick();
+    event.syscall = horizon_diag_current.syscall;
+    event.phase = horizon_diag_current.phase;
+    event.pc = horizon_diag_current.pc;
+    event.sp = horizon_diag_current.sp;
+    if (event.kind == HORIZON_DIAG_PARK_ENTER)
+        event.address = __atomic_load_n(&saved->generation, __ATOMIC_ACQUIRE);
+    horizon_diag_saved_write(saved, &event);
+}
+
+/* Called only by the existing stall monitor, without tracked locks. Each
+ * read releases its slot before formatting/callback; no PE stack is read. */
+void horizon_suspend_diag_dump(void (*print)(const char *line))
+{
+    uint64_t end = __atomic_load_n(&horizon_suspend_ring.sequence, __ATOMIC_RELAXED);
+    uint64_t start = end > HORIZON_DIAG_CAPACITY ? end - HORIZON_DIAG_CAPACITY + 1 : 1;
+    unsigned shown = 0;
+    struct horizon_diag_event event;
+    char line[384];
+    if (!print) return;
+    for (uint64_t sequence = start; sequence <= end; sequence++)
+    {
+        if (!horizon_diag_ring_read(&horizon_suspend_ring, sequence, &event)) continue;
+        snprintf(line, sizeof(line), "[SUSPEND-DIAG] seq=%llu tick=%llu event=%u caller=%x target=%x handle=%llx old=%u new=%u status=%x syscall=%x phase=%u pc=%llx sp=%llx addr=%llx value=%x flags=%x",
+                 (unsigned long long)event.sequence, (unsigned long long)event.timestamp,
+                 event.kind, event.caller, event.target, (unsigned long long)event.handle,
+                 event.old_count, event.new_count, event.status, event.syscall, event.phase,
+                 (unsigned long long)event.pc, (unsigned long long)event.sp,
+                 (unsigned long long)event.address, event.value, event.flags);
+        print(line);
+        shown++;
+    }
+    snprintf(line, sizeof(line), "[SUSPEND-DIAG] end=%llu shown=%u dropped=%llu capacity=%u",
+             (unsigned long long)end, shown,
+             (unsigned long long)__atomic_load_n(&horizon_suspend_ring.dropped, __ATOMIC_RELAXED),
+             HORIZON_DIAG_CAPACITY);
+    print(line);
+}
+
