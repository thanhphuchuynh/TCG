+import tempfile
+root = Path(__file__).resolve().parents[2]
+source = (root / 'dlls/ntdll/unix/signal_arm64.c').read_text()
+horizon = (root / 'dlls/ntdll/unix/horizon.c').read_text()
+def block(text, signature):
+    start = text.index(signature)
+    end, depth = text.index('{', start) + 1, 1
+    while depth:
+        depth += (text[end] == '{') - (text[end] == '}')
+        end += 1
+    return text[start:end]
+fixture = r'''
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winternl.h"
+#include "horizon_suspend_diag.h"
+#define __SWITCH__
+static struct horizon_diag_ring horizon_suspend_ring;
+static __thread struct horizon_diag_scope horizon_diag_current = { .syscall = ~0u };
+static unsigned long long armGetSystemTick(void) { return 12345; }
+'''
+fixture += '\n'.join(block(horizon, name) for name in ('void horizon_diag_scope_push(', 'void horizon_diag_scope_pop(',
+                       'void horizon_diag_scope_phase(', 'void horizon_diag_scope_reset(', 'void horizon_diag_record(', 'void horizon_diag_save('))
+fixture += r'''
+static TEB teb;
+#undef NtCurrentTeb
+#define NtCurrentTeb() (&teb)
+volatile int wine_nx_quit_requested;
+void wine_nx_quit_point(void) __attribute__((weak));
+void wine_nx_quit_point(void) {}
+int wine_nx_runtime_verbose __attribute__((weak));
+void wine_nx_runtime_trace(const char *line) { (void)line; assert(0); }
+static SYSTEM_SERVICE_TABLE KeServiceDescriptorTable[4];
+static unsigned int wine_nx_syscalls, wine_nx_syscall_counts[0x2000];
+static __thread unsigned int wine_nx_syscall_sample;
+NTSTATUS WINAPI NtReadVirtualMemory(HANDLE h, const void *a, void *b, SIZE_T n, SIZE_T *done)
+{ (void)h; (void)a; (void)b; (void)n; (void)done; return 0; }
+/* Suspension-consumer stand-in exercises the production dispatcher's entry
+ * and exit attribution without changing suspension behavior or claiming a park. */
+static void horizon_park_if_suspended(void)
+{ horizon_diag_emit(HORIZON_DIAG_PARK_ENTER, 4, 4, 0, 0, 0, 0, 0, 0, 0); }
+'''
+fixture += block(source, 'ULONG_PTR wine_nx_do_syscall(')
+fixture += r'''
+static ULONG_PTR inner(ULONG_PTR a, ULONG_PTR b, ULONG_PTR c, ULONG_PTR d,
+                       ULONG_PTR e, ULONG_PTR f, ULONG_PTR g, ULONG_PTR h)
+{
+    assert(a == 10 && b == 20 && c == 30 && d == 40 && e == 50 && f == 60 && g == 70 && h == 80);
+    horizon_diag_emit(HORIZON_DIAG_GET_CONTEXT, 4, 8, 0x99, 0, 0, 0, 0, 0, 0);
+    return 0x8877665544332211ULL;
+}
+static ULONG_PTR outer(ULONG_PTR a, ULONG_PTR b, ULONG_PTR c, ULONG_PTR d,
+                       ULONG_PTR e, ULONG_PTR f, ULONG_PTR g, ULONG_PTR h)
+{
+    ULONG_PTR result;
+    assert(a == 1 && b == 2 && c == 3 && d == 4 && e == 5 && f == 6 && g == 7 && h == 8);
+    result = wine_nx_do_syscall((ULONG_PTR *)0x4000, 10,20,30,40,50,60,70,80, 1, 0x2000);
+    horizon_diag_emit(HORIZON_DIAG_GET_CONTEXT, 4, 12, 0x88, 0, 0, 0, 0, 0, 0);
+    return result;
+}
+int main(void)
+{
+    ULONG_PTR services[] = {(ULONG_PTR)outer, (ULONG_PTR)inner, 0};
+    BYTE bytes[] = {64,64,64};
+    struct horizon_diag_event events[16];
+    unsigned n;
+    KeServiceDescriptorTable[0] = (SYSTEM_SERVICE_TABLE){services, NULL, 3, bytes};
+    assert(wine_nx_do_syscall((ULONG_PTR *)0x3000,1,2,3,4,5,6,7,8,0,0x1000) == 0x8877665544332211ULL);
+    assert(horizon_diag_current.syscall == ~0u);
+    n = horizon_diag_ring_snapshot(&horizon_suspend_ring, events, 16);
+    assert(n == 6);
+    for (unsigned i = 0; i < n; i++) {
+        int nested = i >= 1 && i <= 3;
+        assert(events[i].syscall == (unsigned)nested);
+        assert(events[i].pc == (nested ? 0x2000 : 0x1000));
+        assert(events[i].sp == (nested ? 0x4000 : 0x3000));
+    }
+    assert(events[0].phase == HORIZON_DIAG_ENTRY && events[1].phase == HORIZON_DIAG_ENTRY);
+    assert(events[2].phase == HORIZON_DIAG_HANDLER && events[3].phase == HORIZON_DIAG_RETURN);
+    assert(events[4].phase == HORIZON_DIAG_HANDLER && events[5].phase == HORIZON_DIAG_RETURN);
+    assert((NTSTATUS)wine_nx_do_syscall(NULL,0,0,0,0,0,0,0,0,2,0x5000) == STATUS_INVALID_SYSTEM_SERVICE);
+    assert(horizon_diag_current.syscall == ~0u);
+    assert((NTSTATUS)wine_nx_do_syscall(NULL,0,0,0,0,0,0,0,0,4095,0x6000) == STATUS_INVALID_SYSTEM_SERVICE);
+    assert(horizon_diag_current.syscall == ~0u);
+    puts("suspend diagnostics: production dispatcher args/result, nested ID/phase/PC/SP and invalid exits passed");
+}
+'''
+with tempfile.TemporaryDirectory(prefix='suspend-dispatch-') as directory:
+    path = Path(directory)
+    (path / 'test.c').write_text(fixture)
+    subprocess.run([os.environ.get('WINE_NX_HOST_CC', '/usr/bin/clang'), '-std=gnu11', '-g', '-O1',
