+#!/bin/sh
+# Observer tests execute own Autorun host bridge, not FEX upstream code.
+set -eu
+root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
+build="$(mktemp -d "${TMPDIR:-/tmp}/wine-nx-allocation.XXXXXX")"
+trap 'rm -rf "$build"' EXIT HUP INT TERM
+cc="${CC:-clang}"
+"$cc" -g -Wall -Wextra -Werror -pthread -fsanitize=address,undefined \
+    -D__SWITCH__ -I"$root/horizon-wine/tests/fex_horizon" \
+    "$root/horizon-wine/tests/fex_horizon_jit.c" -o "$build/jit"
+"$build/jit"
+python3 "$root/horizon-wine/tests/check_allocation_diagnostics.py"
