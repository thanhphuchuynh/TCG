+int wine_nx_fex_jit_snapshot( struct wine_nx_fex_jit_stats *stats )
+{
+    const struct fex_jit_arena *arena;
+    const struct fex_jit_mapping *mapping;
+    int error;
+
+    if (!stats) return EINVAL;
+    memset( stats, 0, sizeof(*stats) );
+    if ((error = pthread_mutex_trylock( &mapping_lock ))) return error;
+    for (arena = arenas; arena; arena = arena->next)
+    {
+        stats->arena_bytes += arena->size;
+        stats->arenas++;
+    }
+    for (mapping = mappings; mapping; mapping = mapping->next)
+    {
+        stats->buffer_bytes += mapping->size;
+        stats->buffers++;
+    }
+    pthread_mutex_unlock( &mapping_lock );
+    return 0;
+}
