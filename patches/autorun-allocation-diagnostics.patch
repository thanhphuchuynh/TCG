--- /dev/null
+++ b/horizon-wine/tests/check_allocation_diagnostics.py
@@ -0,0 +1,129 @@
+#!/usr/bin/env python3
+"""Execute the actual horizon.c snapshot on a real mapping tree.
+Checks physical deduplication, read-only file classification, logical reservations,
+section aliases, stale freed slots, busy locks and bounded output. No kernel API
+is called by this observer, so a small real-tree host fixture is sufficient.
+"""
+from pathlib import Path
+import re, subprocess, tempfile
+root = Path(__file__).resolve().parents[2]
+s = (root / 'dlls/ntdll/unix/horizon.c').read_text()
+def function(prefix):
+    m = re.search('^' + re.escape(prefix) + r'[^;{]*?\)\s*\n\{', s, re.M | re.S)
+    assert m, 'missing observer: ' + prefix
+    i, depth = m.end(), 1
+    while depth:
+        depth += (s[i] == '{') - (s[i] == '}')
+        i += 1
+    return s[m.start():i] + '\n'
+def block(pattern):
+    m = re.search(pattern, s, re.M | re.S)
+    assert m, pattern
+    return m.group(0) + '\n'
+fixture = r'''
+#include <assert.h>
+#include <errno.h>
+#include <pthread.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/types.h>
+#include "wine/rbtree.h"
+#include "horizon_pool.h"
+typedef int BOOL;
+typedef void VirtmemReservation;
+static pthread_mutex_t mapping_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_mutex_t section_pages_mutex = PTHREAD_MUTEX_INITIALIZER;
+static struct horizon_page_pool backing_pages, section_pages;
+static unsigned long long section_pages_requested_bytes;
+'''
+fixture += block(r'struct horizon_backing\n\{.*?\n\};')
+fixture += block(r'enum horizon_section_state\n\{.*?\n\};')
+fixture += block(r'struct horizon_mapping\n\{.*?\n\};')
+fixture += function('static void *section_pages_alloc')
+fixture += function('static void section_pages_free')
+fixture += function('static int compare_mapping')
+fixture += 'static struct rb_tree mappings = { compare_mapping, NULL };\n'
+fixture += function('void horizon_memory_allocation_stats')
+fixture += r'''
+static void expect(const char *line, const char *field, unsigned long long value)
+{
+    char expected[96];
+    snprintf(expected, sizeof(expected), "%s=%llu ", field, value);
+    if (!strstr(line, expected)) { fprintf(stderr, "missing %s in %s\n", expected, line); abort(); }
+}
+int main(void)
+{
+    void *small = section_pages_alloc(4096);
+    void *large = section_pages_alloc(3u * 1024 * 1024);
+    assert(small && large && section_pages_requested_bytes == 4096u + 3u * 1024 * 1024);
+    assert(!section_pages_alloc(0));
+    assert(section_pages_requested_bytes == 4096u + 3u * 1024 * 1024);
+    section_pages_free(small, 4096);
+    assert(section_pages_requested_bytes == 3u * 1024 * 1024);
+    section_pages_free(large, 3u * 1024 * 1024);
+    assert(!section_pages_requested_bytes);
+    horizon_pages_trim(&section_pages);
+    char line[640], tiny[2] = {'x','y'};
+    /* One anonymous backing split across two aliases, and one read-only file
+     * backing (no retained fd, unlike writable shared mappings). */
+    struct horizon_backing backing[3] = {
+        {.heap_addr=(void *)1, .size=12288, .refs=2, .fd=-1},
+        {.heap_addr=(void *)2, .size=8192, .refs=1, .fd=-1, .diagnostic_file_backed=1},
+        {.heap_addr=(void *)3, .size=999999, .refs=1, .fd=-1}
+    };
+    struct horizon_mapping views[6] = {
+        {.addr=(void *)0x10000, .size=4096, .backing=&backing[0]},
+        {.addr=(void *)0x20000, .size=8192, .backing=&backing[0]},
+        {.addr=(void *)0x30000, .size=8192, .backing=&backing[1]},
+        {.addr=(void *)0x40000, .size=65536, .reservation=(void *)1},
+        {.addr=(void *)0x60000, .size=4096, .section_state=SECTION_ALIASED},
+        {.addr=(void *)0x70000, .size=8192, .section_state=SECTION_NATIVE}
+    };
+    struct horizon_page_arena bp = {.memory=(void *)1, .free_pages=3};
+    struct horizon_page_arena sp = {.memory=(void *)2, .free_pages=7};
+    backing_pages.arenas=&bp; backing_pages.capacity=1;
+    section_pages.arenas=&sp; section_pages.capacity=1;
+    section_pages_requested_bytes=65536; /* descriptor-owned backing exceeds active view */
+    for (unsigned int i=0; i<6; ++i) assert(!rb_put(&mappings, views[i].addr, &views[i].entry));
+    for (unsigned int repeat=0; repeat<3; ++repeat)
+    {
+        horizon_memory_allocation_stats(line, sizeof(line));
+        expect(line, "anon_requested_bytes", 12288);
+        expect(line, "file_requested_bytes", 8192);
+        expect(line, "backings", 2);
+        expect(line, "logical_bytes", 98304);
+        expect(line, "reservation_bytes", 65536);
+        expect(line, "section_alias_bytes", 4096);
+        expect(line, "section_native_bytes", 8192);
+        expect(line, "pool_spare_bytes", 40960);
+        expect(line, "section_requested_bytes", 65536);
+    }
+    /* Freed-slot metadata must never appear in a live snapshot. */
+    rb_remove(&mappings, &views[2].entry);
+    horizon_memory_allocation_stats(line, sizeof(line));
+    expect(line, "file_requested_bytes", 0); expect(line, "backings", 1);
+    pthread_mutex_lock(&mapping_mutex);
+    horizon_memory_allocation_stats(line, sizeof(line));
+    assert(!strcmp(line, "[ALLOC] busy=mappings"));
+    pthread_mutex_unlock(&mapping_mutex);
+    pthread_mutex_lock(&section_pages_mutex);
+    horizon_memory_allocation_stats(line, sizeof(line));
+    assert(!strcmp(line, "[ALLOC] busy=sections"));
+    assert(!pthread_mutex_trylock(&mapping_mutex));
+    pthread_mutex_unlock(&mapping_mutex);
+    pthread_mutex_unlock(&section_pages_mutex);
+    horizon_memory_allocation_stats(tiny, sizeof(tiny));
+    assert(tiny[1] == 0);
+    horizon_memory_allocation_stats(NULL, 0);
+    puts("Allocation snapshot: alias dedup, file/private, stale slots, logical reservations, sections, pool spare, trylocks and bounds passed");
+}
+'''
+with tempfile.TemporaryDirectory() as td:
+    src, exe = Path(td)/'test.c', Path(td)/'test'
+    src.write_text(fixture)
+    subprocess.run(['clang','-g','-Wall','-Wextra','-Werror','-pthread','-fsanitize=address,undefined',
+        '-I'+str(root/'include'),'-I'+str(root/'dlls/ntdll/unix'),str(src),'-o',str(exe)],check=True)
+    subprocess.run([str(exe)],check=True)
